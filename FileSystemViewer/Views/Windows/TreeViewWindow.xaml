<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FileSystemViewer.Views.Windows.TreeViewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileSystemViewer.Views.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FileSystemViewer.ViewModels"
    mc:Ignorable="d"
    xmlns:models="using:FileSystemViewer.Models"
    xmlns:converters="using:FileSystemViewer.Views.Converters"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:mControls="using:ModernControls"
    Title="TreeViewWindow">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="TitleBar"
            Grid.Row="0" 
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            Title="Visual tree window"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">

            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/drive.ico"/>
            </TitleBar.IconSource>
        </TitleBar>

        <Grid
            Grid.Row="1">
            <TreeView 
                x:Name="FileSystemTreeView"
                ItemsSource="{x:Bind ViewModel.DriveNodes, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedFileSystemNode, Mode=TwoWay}"
                ItemTemplate="{StaticResource FileSystemNodeTemplate}"
                ScrollViewer.VerticalScrollBarVisibility="Visible"/>
        </Grid>
    </Grid>
</Window>
