<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FileSystemViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileSystemViewer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:mControls="using:ModernControls.Controls"
    Title="FileSystem-Viewer"
    x:Name="mainWindow">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid 
        x:Name="rootGrid"
        Background="Transparent"
        AllowDrop="True"
        DragEnter="rootGrid_DragEnter"
        DragOver="rootGrid_DragOver"
        Drop="rootGrid_Drop"
        DragLeave="rootGrid_DragLeave">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="TitleBar"
            SizeChanged="TitleBar_SizeChanged"
            Grid.Row="0" 
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Title="File Viewer"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">

            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/appIcon.png"/>
            </TitleBar.IconSource>

            <TitleBar.LeftHeader>
                <Button
                    Command="{x:Bind MainPageViewModel.OpenSettingsMenuCommand}"
                    Margin="5,0,-5,0"
                    Background="Transparent"
                    BorderThickness="0.5"
                    Width="35"
                    Height="35">

                    <Viewbox
                        Margin="-1.2">
                        <FontIcon
                            Glyph="&#xE713;"/>
                    </Viewbox>
                </Button>
            </TitleBar.LeftHeader>
        </TitleBar>

        <Frame
            Grid.Row="1"
            x:Name="RootFrame"/>

        <Frame
            Grid.Row="1"
            x:Name="SettingsFrame"
            Visibility="{x:Bind MainPageViewModel.ApplicationState.SettingsMenuVisibility, Mode=OneWay}"/>
        
        <Frame
            Grid.Row="1"
            x:Name="ReportViewerFrame"
            Visibility="{x:Bind MainPageViewModel.ApplicationState.ReportViewerVisibility, Mode=OneWay}"/>

        <Border
            x:Name="criticalDrop"
            Grid.Column="0"
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Grid.RowSpan="3"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Padding="5"
            Visibility="Collapsed">

            <Border
                BorderThickness="1"
                CornerRadius="10"
                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"/>
        </Border>

        <Border
            x:Name="positiveDrop"
            Grid.Column="0"
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Grid.RowSpan="3"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Padding="5"
            Visibility="Collapsed">

            <Border
                BorderThickness="1"
                CornerRadius="10"
                BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"/>
        </Border>
    </Grid>
</Window>
