<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileSystemViewer.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileSystemViewer.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    Background="Transparent"
    xmlns:l="using:WinUI3Localizer"
    x:Name="settingsPage">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!--Header grid-->
        <Grid
            Grid.Row="0">
            <Border
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                Opacity="0.3"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CircleElevationBorderBrush}"/>

            <Button
                Command="{x:Bind ViewModel.CloseSettingsMenuCommand}"
                CommandParameter="{Binding ElementName=settingsPage, Path=XamlRoot}"
                HorizontalAlignment="Right"
                Content="&#xE711;"
                Style="{StaticResource SettingsPageHeaderButtons}"/>

            <StackPanel
                Margin="10,0,0,0"
                Orientation="Horizontal"
                Spacing="10">

                <FontIcon
                    FontSize="17"
                    Glyph="&#xE9F5;"/>

                <TextBlock
                    VerticalAlignment="Center"
                    l:Uids.Uid="SettingsPageHeader"
                    FontSize="13"
                    FontWeight="SemiLight"/>
                <TextBlock
                    Margin="-7,0,0,0"
                    VerticalAlignment="Center"
                    Text="*">
        
                    <i:Interaction.Behaviors>
                        <i:DataTriggerBehavior Binding="{x:Bind ViewModel.IsThereUnsavedChanges, Mode=OneWay}" ComparisonCondition="Equal" Value="True">
                            <i:ChangePropertyAction PropertyName="Visibility" Value="Visible"/>
                        </i:DataTriggerBehavior>
                        <i:DataTriggerBehavior Binding="{x:Bind ViewModel.IsThereUnsavedChanges, Mode=OneWay}" ComparisonCondition="Equal" Value="False">
                            <i:ChangePropertyAction PropertyName="Visibility" Value="Collapsed"/>
                        </i:DataTriggerBehavior>
                    </i:Interaction.Behaviors>
                </TextBlock>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="3">

                    <Button
                        Command="{x:Bind ViewModel.ImportSettingsCommand}"
                        CommandParameter="{Binding ElementName=settingsPage, Path=XamlRoot}"
                        Content="&#xE8B5;"
                        Style="{StaticResource SettingsPageHeaderButtons}">

                        <ToolTipService.ToolTip>
                            <TextBlock l:Uids.Uid="ImportButton"/>
                        </ToolTipService.ToolTip>
                    </Button>

                    <Border
                        Margin="0,5,0,5"
                        Width="1"
                        Background="{ThemeResource CircleElevationBorderBrush}"/>

                    <Button
                        Command="{x:Bind ViewModel.ExportSettingsCommand}"
                        CommandParameter="{Binding ElementName=settingsPage, Path=XamlRoot}"
                        Content="&#xEDE1;"
                        Style="{StaticResource SettingsPageHeaderButtons}">
                        
                        <ToolTipService.ToolTip>
                            <TextBlock l:Uids.Uid="ExportButton"/>
                        </ToolTipService.ToolTip>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Pivot
            Grid.Row="1">
            <!--System settings-->
            <PivotItem>
                <PivotItem.Header>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10">

                        <FontIcon
                            FontSize="15"
                            Glyph="&#xE770;"/>

                        <TextBlock
                            FontSize="15"
                            l:Uids.Uid="SystemTab"/>
                    </StackPanel>
                </PivotItem.Header>

                <!--Content-->
                <StackPanel
                    Margin="0,5,0,0"
                    Orientation="Vertical"
                    Grid.Row="1">

                    <!--Tray activity toggle settings-->
                    <Border
                        Style="{StaticResource SettingsPanelBorder}">
                        <StackPanel
                            Padding="10,0,0,5"
                            Orientation="Horizontal"
                            Spacing="10">

                            <TextBlock
                                Style="{StaticResource SettingsPagePanelHeaderStyle}"
                                l:Uids.Uid="SystemTraySection"/>

                            <ToggleSwitch
                                Margin="0,4,0,0"
                                IsOn="{x:Bind ViewModel.IsTrayToggleOn, Mode=TwoWay}">

                                <ToggleSwitch.OnContent>
                                    <TextBlock
                                        l:Uids.Uid="SwitchStateOn"/>
                                </ToggleSwitch.OnContent>

                                <ToggleSwitch.OffContent>
                                    <TextBlock
                                        l:Uids.Uid="SwitchStateOff"/>
                                </ToggleSwitch.OffContent>
                            </ToggleSwitch>
                        </StackPanel>
                    </Border>

                    <!--Scheduled scan settings-->
                    <Border
                        Style="{StaticResource SettingsPanelBorder}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <!--Header-->
                            <StackPanel
                                Grid.Row="0"
                                Padding="10,0,0,5"
                                Orientation="Horizontal"
                                Spacing="10">

                                <TextBlock
                                    Style="{StaticResource SettingsPagePanelHeaderStyle}"
                                    l:Uids.Uid="ScheduledScanningSection"/>

                                <ToggleSwitch
                                    x:Name="ScheduledScanToggle"
                                    Margin="0,4,0,0"
                                    IsOn="{x:Bind ViewModel.IsSchedulerScanToggleOn, Mode=TwoWay}">

                                    <ToggleSwitch.OnContent>
                                        <TextBlock
                                            l:Uids.Uid="SwitchStateOn"/>
                                    </ToggleSwitch.OnContent>

                                    <ToggleSwitch.OffContent>
                                        <TextBlock
                                            l:Uids.Uid="SwitchStateOff"/>
                                    </ToggleSwitch.OffContent>
                                </ToggleSwitch>
                            </StackPanel>

                            <!--Content-->
                            <Grid
                                Grid.Row="1"
                                Padding="10,0,0,5">

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="20">

                                    <TimePicker
                                        x:Name="DailyScanTimePicker"
                                        IsEnabled="{Binding ElementName=ScheduledScanToggle, Path=IsOn, Mode=OneWay}"
                                        MinuteIncrement="15"
                                        ClockIdentifier="24HourClock"
                                        SelectedTime="{x:Bind ViewModel.ScheduledScanTimeSpan, Mode=TwoWay}">

                                        <TimePicker.Header>
                                            <TextBlock
                                                l:Uids.Uid="IntervalHeader"/>
                                        </TimePicker.Header>
                                    </TimePicker>

                                    <NumberBox
                                        IsEnabled="{Binding ElementName=ScheduledScanToggle, Path=IsOn, Mode=OneWay}"
                                        Value="{x:Bind ViewModel.MinCriticalFreeSpacePercent, Mode=TwoWay}"
                                        SmallChange="10"
                                        Minimum="0"
                                        Maximum="100"
                                        SpinButtonPlacementMode="Inline">

                                        <NumberBox.Header>
                                            <TextBlock
                                                l:Uids.Uid="MinCritSpaceHeader"/>
                                        </NumberBox.Header>
                                    </NumberBox>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </PivotItem>

            <!--Visual settings-->
            <PivotItem>
                <PivotItem.Header>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10">

                        <FontIcon
                            FontSize="15"
                            Glyph="&#xE890;"/>

                        <TextBlock
                            FontSize="15"
                            l:Uids.Uid="VisualTab"/>
                    </StackPanel>
                </PivotItem.Header>

                <ScrollViewer
                    VerticalScrollMode="Enabled"
                    HorizontalScrollMode="Disabled">
                    
                    <StackPanel
                        Orientation="Vertical">

                        <!--Language-->
                        <Border
                            Style="{StaticResource SettingsPanelBorder}">

                            <StackPanel
                                Padding="10,0,0,5"
                                Orientation="Vertical">

                                <TextBlock
                                    Style="{StaticResource SettingsPagePanelHeaderStyle}"
                                    l:Uids.Uid="LanguageSection"/>

                                <SelectorBar>
                                    <SelectorBarItem Text="UA" IsSelected="{x:Bind ViewModel.IsUALanguageSelected, Mode=TwoWay}">
                                        <SelectorBarItem.Icon>
                                            <ImageIcon Source="../../Assets/ua.png" Width="30" Margin="0,-5,0,0"/>
                                        </SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                    <SelectorBarItem Text="ENG" IsSelected="{x:Bind ViewModel.IsENGLanguageSelected, Mode=TwoWay}">
                                        <SelectorBarItem.Icon>
                                            <ImageIcon Source="../../Assets/uk.png" Width="30" Margin="0,-5,0,0"/>
                                        </SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                </SelectorBar>
                               
                            </StackPanel>
                        </Border>

                        <!--Theme-->
                        <Border
                            Style="{StaticResource SettingsPanelBorder}">

                            <StackPanel
                                Padding="10,5,0,5"
                                Orientation="Vertical">

                                <TextBlock
                                    Style="{StaticResource SettingsPagePanelHeaderStyle}"
                                    l:Uids.Uid="ThemeSection"/>

                                <SelectorBar>
                                    <SelectorBarItem l:Uids.Uid="ThemeSectionLight" IsSelected="{x:Bind ViewModel.IsLightThemeSelected, Mode=TwoWay}">
                                        <SelectorBarItem.Icon>
                                            <FontIcon Glyph="&#xE706;"/>
                                        </SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                    <SelectorBarItem l:Uids.Uid="ThemeSectionDark" Text="Dark" IsSelected="{x:Bind ViewModel.IsDarkThemeSelected, Mode=TwoWay}">
                                        <SelectorBarItem.Icon>
                                            <FontIcon Glyph="&#xE708;"/>
                                        </SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                    <SelectorBarItem l:Uids.Uid="ThemeSectionSystem" Text="System" IsSelected="{x:Bind ViewModel.IsSystemThemeSelected, Mode=TwoWay}">
                                        <SelectorBarItem.Icon>
                                            <FontIcon Glyph="&#xE770;"/>
                                        </SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                </SelectorBar>
                            </StackPanel>
                        </Border>

                        <!--Accent-->
                        <Border
                            Style="{StaticResource SettingsPanelBorder}">

                            <StackPanel
                                Padding="10,5,0,5"
                                Orientation="Vertical">

                                <TextBlock
                                    Style="{StaticResource SettingsPagePanelHeaderStyle}"
                                    l:Uids.Uid="AccentColorSection"/>

                                <!--System accent switcher-->
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="10">

                                    <TextBlock
                                        l:Uids.Uid="UseDefaultAccent"
                                        VerticalAlignment="Center"/>

                                    <ToggleSwitch
                                        x:Name="DefaultAccentToggle"
                                        IsOn="{x:Bind ViewModel.IsSystemAccentColorUsed, Mode=TwoWay}">

                                        <ToggleSwitch.OnContent>
                                            <TextBlock
                                                l:Uids.Uid="SwitchStateOn"/>
                                        </ToggleSwitch.OnContent>

                                        <ToggleSwitch.OffContent>
                                            <TextBlock
                                                l:Uids.Uid="SwitchStateOff"/>
                                        </ToggleSwitch.OffContent>
                                    </ToggleSwitch>
                                </StackPanel>

                                <ColorPicker
                                    Color="{x:Bind ViewModel.CustomAccentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    HorizontalAlignment="Left"
                                    IsMoreButtonVisible="False"
                                    IsColorSliderVisible="True"
                                    IsColorChannelTextInputVisible="False"
                                    IsHexInputVisible="False"
                                    IsAlphaEnabled="False">

                                    <i:Interaction.Behaviors>
                                        <i:DataTriggerBehavior Binding="{Binding ElementName=DefaultAccentToggle, Path=IsOn}" ComparisonCondition="Equal" Value="False">
                                            <i:ChangePropertyAction PropertyName="Visibility" Value="Visible"/>
                                        </i:DataTriggerBehavior>
                                        <i:DataTriggerBehavior Binding="{Binding ElementName=DefaultAccentToggle, Path=IsOn}" ComparisonCondition="Equal" Value="True">
                                            <i:ChangePropertyAction PropertyName="Visibility" Value="Collapsed"/>
                                        </i:DataTriggerBehavior>
                                    </i:Interaction.Behaviors>
                                </ColorPicker>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

        <!--Right-bottom corner buttons panel-->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,10,10"
            Orientation="Horizontal"
            Spacing="5">

            <Button
                Command="{x:Bind ViewModel.RestoreSettingsCommand}"
                CommandParameter="{Binding ElementName=settingsPage, Path=XamlRoot, Mode=TwoWay}">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10">

                    <FontIcon
                        VerticalAlignment="Center"
                        Glyph="&#xE777;"
                        FontSize="16"/>

                    <TextBlock
                        VerticalAlignment="Center"
                        l:Uids.Uid="RestoreButtonText"/>
                </StackPanel>
            </Button>

            <Button
                Command="{x:Bind ViewModel.SetSettingsByDefaultCommand}"
                CommandParameter="{Binding ElementName=settingsPage, Path=XamlRoot, Mode=TwoWay}">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10">

                    <FontIcon
                        VerticalAlignment="Center"
                        Glyph="&#xE835;"
                        FontSize="16"/>

                    <TextBlock
                        VerticalAlignment="Center"
                        l:Uids.Uid="ByDefaultButtonText"/>
                </StackPanel>
            </Button>

            <Button
                Command="{x:Bind ViewModel.SaveSettingsCommand}"
                Style="{ThemeResource AccentButtonStyle}">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10">

                    <FontIcon
                        VerticalAlignment="Center"
                        Glyph="&#xE74E;"
                        FontSize="16"/>

                    <TextBlock
                        VerticalAlignment="Center"
                        l:Uids.Uid="SaveButtonText"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
