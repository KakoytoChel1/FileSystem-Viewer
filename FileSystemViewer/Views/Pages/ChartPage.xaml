<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileSystemViewer.Views.Pages.ChartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileSystemViewer.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:converters="using:FileSystemViewer.Views.Converters"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:l="using:WinUI3Localizer">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Pivot Grid.Row="1">
            <PivotItem>
                <PivotItem.Header>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10">

                        <FontIcon
                            FontSize="15"
                            Glyph="&#xE9A4;"/>

                        <TextBlock
                            FontSize="15"
                            l:Uids.Uid="ListTab"/>
                    </StackPanel>
                </PivotItem.Header>

                <ScrollViewer
                    HorizontalScrollBarVisibility="Visible" 
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Disabled">
                    
                    <Grid>
                        <ListView
                            ItemsSource="{x:Bind ViewModel.ApplicationState.FileExtensionItems, Mode=OneWay}"
                            ShowsScrollingPlaceholders="True">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="ListViewItem">
                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="auto" MinWidth="100"/>
                                            <ColumnDefinition Width="auto" MinWidth="80"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!--Extension-->
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding Extension}"
                                            ToolTipService.ToolTip="{Binding Extension}"/>

                                        <!--Color-->
                                        <Border
                                            Grid.Column="1"
                                            Width="25"
                                            Height="25"
                                            Background="{Binding Color, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                            CornerRadius="6"/>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Grid.Column="2"
                                            Text="{Binding Percent, Converter={StaticResource DoubleIntoStringConverter}}"/>

                                        <!--Size-->
                                        <StackPanel
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="5">

                                            <TextBlock
                                                Text="{Binding Size, Converter={StaticResource BytesIntoSuitableFormatConverter}}"/>

                                            <FontIcon
                                                FontSize="14"
                                                Glyph="&#xE9F9;"/>
                                        </StackPanel>

                                        <!--File count-->
                                        <StackPanel
                                            Grid.Column="4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="5">

                                            <TextBlock
                                                Text="{Binding FileCount}"/>

                                            <FontIcon
                                                FontSize="14"
                                                Glyph="&#xE7C3;"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <PivotItem>
                <PivotItem.Header>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10">

                        <FontIcon
                            FontSize="15"
                            Glyph="&#xEB05;"/>

                        <TextBlock
                            FontSize="15"
                            l:Uids.Uid="ChartTab"/>
                    </StackPanel>
                </PivotItem.Header>

                <Grid>
                    <lvc:PieChart
                        Series="{x:Bind ViewModel.ApplicationState.FileExtensionSeriesCollection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Background="Transparent"
                        TooltipPosition="Center"/>
                </Grid>
            </PivotItem>
        </Pivot>

        <Grid Canvas.ZIndex="1" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            
            <Expander
                Grid.Row="0"
                VerticalAlignment="Top"
                Margin="10,10,5,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">

                <Expander.Header>
                    <StackPanel
                        Spacing="10"
                        Orientation="Horizontal">

                        <FontIcon
                        Glyph="&#xED25;"/>

                        <TextBlock
                            l:Uids.Uid="ChartPageExpander"/>
                    </StackPanel>
                </Expander.Header>

                <ListView 
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    Margin="-15"
                    SelectionMode="None"
                    ItemsSource="{x:Bind ViewModel.ApplicationState.ScannedRootNodeNames}">
                </ListView>
            </Expander>

            <Button
                Grid.Column="1"
                VerticalAlignment="Top"
                Margin="0,12,10,0"
                HorizontalAlignment="Center"
                Height="45"
                Style="{StaticResource CommandBarButtonStyle}"
                Content="&#xE8A7;"
                Command="{x:Bind ViewModel.OpenChartTabsNewWindowCommand}">

                <ToolTipService.ToolTip>
                    <TextBlock l:Uids.Uid="OpenInNewWindowButton"/>
                </ToolTipService.ToolTip>
            </Button>
        </Grid>

        <ProgressRing
            Width="45"
            Height="45"
            Grid.Row="1">

            <i:Interaction.Behaviors>
                <!--Paused-->
                <i:DataTriggerBehavior Binding="{x:Bind ViewModel.ApplicationState.CurrentScanningState, Mode=OneWay, Converter={StaticResource EnumPropertyToIntConverter}}" ComparisonCondition="Equal" Value="2">
                    <i:ChangePropertyAction PropertyName="Visibility" Value="Visible"/>
                </i:DataTriggerBehavior>

                <!--In progress-->
                <i:DataTriggerBehavior Binding="{x:Bind ViewModel.ApplicationState.CurrentScanningState, Mode=OneWay, Converter={StaticResource EnumPropertyToIntConverter}}" ComparisonCondition="Equal" Value="4">
                    <i:ChangePropertyAction PropertyName="Visibility" Value="Visible"/>
                </i:DataTriggerBehavior>

                <!--Completed-->
                <i:DataTriggerBehavior Binding="{x:Bind ViewModel.ApplicationState.CurrentScanningState, Mode=OneWay, Converter={StaticResource EnumPropertyToIntConverter}}" ComparisonCondition="Equal" Value="1">
                    <i:ChangePropertyAction PropertyName="Visibility" Value="Collapsed"/>
                </i:DataTriggerBehavior>

                <!--Canceled-->
                <i:DataTriggerBehavior Binding="{x:Bind ViewModel.ApplicationState.CurrentScanningState, Mode=OneWay, Converter={StaticResource EnumPropertyToIntConverter}}" ComparisonCondition="Equal" Value="3">
                    <i:ChangePropertyAction PropertyName="Visibility" Value="Collapsed"/>
                </i:DataTriggerBehavior>

                <!--None-->
                <i:DataTriggerBehavior Binding="{x:Bind ViewModel.ApplicationState.CurrentScanningState, Mode=OneWay, Converter={StaticResource EnumPropertyToIntConverter}}" ComparisonCondition="Equal" Value="0">
                    <i:ChangePropertyAction PropertyName="Visibility" Value="Collapsed"/>
                </i:DataTriggerBehavior>
            </i:Interaction.Behaviors>
        </ProgressRing>
    </Grid>
</Page>
