<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileSystem_Viewer.Views.Pages.ChartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileSystem_Viewer.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:converters="using:FileSystemViewer.Views.Converters"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">

    <Page.Resources>
        <converters:BytesIntoSuitableFormatConverter x:Key="BytesIntoSuitableFormatConverter"/>
        <converters:DoubleIntoStringConverter x:Key="DoubleIntoStringConverter"/>
        <converters:ColorToSolidColorBrushConverter x:Key="ColorToSolidColorBrushConverter"/>
        <converters:EnumPropertyToIntConverter x:Key="EnumPropertyToIntConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Pivot Grid.Row="1">
            <PivotItem>
                <PivotItem.Header>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10">

                        <FontIcon
                            FontSize="15"
                            Glyph="&#xE9A4;"/>

                        <TextBlock
                            FontSize="15"
                            Text="List"/>
                    </StackPanel>
                </PivotItem.Header>

                <ScrollViewer
                    HorizontalScrollBarVisibility="Visible" 
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Disabled">
                    
                    <Grid>
                        <ListView
                            ItemsSource="{x:Bind ViewModel.ApplicationState.FileExtensionItems}"
                            ShowsScrollingPlaceholders="True">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="ListViewItem">
                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="auto" MinWidth="100"/>
                                            <ColumnDefinition Width="auto" MinWidth="80"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!--Extension-->
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding Extension}"
                                            ToolTipService.ToolTip="{Binding Extension}"/>

                                        <!--Color-->
                                        <Border
                                            Grid.Column="1"
                                            Width="25"
                                            Height="25"
                                            Background="{Binding Color, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                            CornerRadius="6"/>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Grid.Column="2"
                                            Text="{Binding Percent, Converter={StaticResource DoubleIntoStringConverter}}"/>

                                        <!--Size-->
                                        <StackPanel
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="5">

                                            <TextBlock
                                                Text="{Binding Size, Converter={StaticResource BytesIntoSuitableFormatConverter}}"/>

                                            <FontIcon
                                                FontSize="14"
                                                Glyph="&#xE9F9;"/>
                                        </StackPanel>

                                        <!--File count-->
                                        <StackPanel
                                            Grid.Column="4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="5">

                                            <TextBlock
                                                Text="{Binding FileCount}"/>

                                            <FontIcon
                                                FontSize="14"
                                                Glyph="&#xE7C3;"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <PivotItem>
                <PivotItem.Header>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10">

                        <FontIcon
                            FontSize="15"
                            Glyph="&#xEB05;"/>

                        <TextBlock
                            FontSize="15"
                            Text="Chart"/>
                    </StackPanel>
                </PivotItem.Header>

                <Grid>
                    <lvc:PieChart
                        Series="{x:Bind ViewModel.ApplicationState.FileExtensionSeriesCollection}"
                        Background="Transparent"
                        TooltipPosition="Center"/>
                </Grid>
            </PivotItem>
        </Pivot>

        <Expander
            Grid.Row="0"
            Grid.RowSpan="2"
            VerticalAlignment="Top"
            Canvas.ZIndex="1"
            Margin="10,10,10,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">

            <Expander.Header>
                <StackPanel
                    Spacing="10"
                    Orientation="Horizontal">

                    <FontIcon
                        Glyph="&#xED25;"/>

                    <TextBlock
                        Text="Directories"/>
                </StackPanel>
            </Expander.Header>

            <ListView 
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Margin="-15"
                SelectionMode="None"
                ItemsSource="{x:Bind ViewModel.ApplicationState.ScannedRootNodeNames}">
            </ListView>
        </Expander>

        <ProgressRing
            Width="45"
            Height="45"
            Grid.Row="1">

            <i:Interaction.Behaviors>
                <!--Paused-->
                <i:DataTriggerBehavior Binding="{x:Bind ViewModel.ApplicationState.CurrentScanningState, Mode=OneWay, Converter={StaticResource EnumPropertyToIntConverter}}" ComparisonCondition="Equal" Value="2">
                    <i:ChangePropertyAction PropertyName="Visibility" Value="Visible"/>
                </i:DataTriggerBehavior>

                <!--In progress-->
                <i:DataTriggerBehavior Binding="{x:Bind ViewModel.ApplicationState.CurrentScanningState, Mode=OneWay, Converter={StaticResource EnumPropertyToIntConverter}}" ComparisonCondition="Equal" Value="4">
                    <i:ChangePropertyAction PropertyName="Visibility" Value="Visible"/>
                </i:DataTriggerBehavior>

                <!--Completed-->
                <i:DataTriggerBehavior Binding="{x:Bind ViewModel.ApplicationState.CurrentScanningState, Mode=OneWay, Converter={StaticResource EnumPropertyToIntConverter}}" ComparisonCondition="Equal" Value="1">
                    <i:ChangePropertyAction PropertyName="Visibility" Value="Collapsed"/>
                </i:DataTriggerBehavior>

                <!--Canceled-->
                <i:DataTriggerBehavior Binding="{x:Bind ViewModel.ApplicationState.CurrentScanningState, Mode=OneWay, Converter={StaticResource EnumPropertyToIntConverter}}" ComparisonCondition="Equal" Value="3">
                    <i:ChangePropertyAction PropertyName="Visibility" Value="Collapsed"/>
                </i:DataTriggerBehavior>

                <!--None-->
                <i:DataTriggerBehavior Binding="{x:Bind ViewModel.ApplicationState.CurrentScanningState, Mode=OneWay, Converter={StaticResource EnumPropertyToIntConverter}}" ComparisonCondition="Equal" Value="0">
                    <i:ChangePropertyAction PropertyName="Visibility" Value="Collapsed"/>
                </i:DataTriggerBehavior>
            </i:Interaction.Behaviors>
        </ProgressRing>
    </Grid>
</Page>
