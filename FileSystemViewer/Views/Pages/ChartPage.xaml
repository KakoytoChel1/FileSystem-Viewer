<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileSystem_Viewer.Views.Pages.ChartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileSystem_Viewer.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">

    <Grid>
        <Pivot>
            <PivotItem>
                <PivotItem.Header>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10">

                        <FontIcon
                            FontSize="15"
                            Glyph="&#xE9A4;"/>

                        <TextBlock
                            FontSize="15"
                            Text="List"/>
                    </StackPanel>
                </PivotItem.Header>

                <Grid>
                    <ListView>
                        
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem>
                <PivotItem.Header>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10">

                        <FontIcon
                            FontSize="15"
                            Glyph="&#xEB05;"/>

                        <TextBlock
                            FontSize="15"
                            Text="Chart"/>
                    </StackPanel>
                </PivotItem.Header>

                <Grid>
                    <lvc:PieChart
                        Background="Transparent"/>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
