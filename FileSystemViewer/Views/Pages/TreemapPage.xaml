<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileSystemViewer.Views.Pages.TreemapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileSystemViewer.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mControls="using:ModernControls.Controls"
    mc:Ignorable="d">

    <Grid>

        <mControls:HierarchicalTreemap
            x:Name="hierarchicalTreemap"
            GlyphIcon="&#xE838;"
            Separator="\"
            ItemsSource="{x:Bind MainPageViewModel.TreemapNodes, Mode=OneWay}"/>

        <Button
            Style="{StaticResource CommandBarButtonStyle}"
            ToolTipService.ToolTip="Open in new window"
            Content="&#xE8A7;"
            Height="27"
            Width="35"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,5,5,0"
            Command="{x:Bind MainPageViewModel.OpenTreeMapNewWindowCommand}">
        </Button>
    </Grid>
</Page>
