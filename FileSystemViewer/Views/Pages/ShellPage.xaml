<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileSystemViewer.Views.Pages.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileSystemViewer.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates" CurrentStateChanged="LayoutStates_CurrentStateChanged">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="MiddleState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="700" />
                    </VisualState.StateTriggers>
                </VisualState>
                
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="*"/>
            <RowDefinition x:Name="MiddleRow" Height="Auto"/>
            <RowDefinition x:Name="BottomRow" Height="0.4*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="*"/>
            <ColumnDefinition x:Name="MiddleColumn" Width="Auto"/>
            <ColumnDefinition x:Name="RightColumn" Width="0.4*"/>
        </Grid.ColumnDefinitions>
        
        <Border 
            x:Name="MainBorder" 
            Grid.Column="0" 
            Grid.Row="0" 
            Margin="5,0,2.5,2.5" 
            Style="{ThemeResource CardBorderStyle}">

            <Frame x:Name="MainPageFrame" />
        </Border>

        <controls:GridSplitter x:Name="VerticalSplitter" Grid.Column="1"/>

        <Border 
            x:Name="ChartBorder" 
            Grid.Column="2" 
            Grid.Row="0"
            Margin="2.5,0,5,2.5" 
            Style="{ThemeResource CardBorderStyle}">

            <Frame x:Name="ChartPageFrame" />
        </Border>

        <controls:GridSplitter x:Name="HorizontalSplitter" Grid.Row="1" Grid.ColumnSpan="3"/>
        
        <Border 
            x:Name="TreemapBorder"
            Grid.Column="0"
            Grid.Row="2" 
            Grid.ColumnSpan="3"
            Margin="5,2.5,5,5" 
            Style="{ThemeResource CardBorderStyle}">

            <Frame x:Name="TreemapPageFrame" />
        </Border>
    </Grid>
</Page>
