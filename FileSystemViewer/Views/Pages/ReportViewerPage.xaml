<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileSystemViewer.Views.Pages.ReportViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileSystemViewer.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <TabView
            TabItemsSource="{x:Bind ViewModel.ScanReports, Mode=OneWay}">

            <TabView.TabItemTemplate>
                <DataTemplate>
                    <TabViewItem>
                        <TabViewItem.Header>
                            <StackPanel
                                Orientation="Horizontal">
                                <TextBlock
                                    Text="Report"/>
                            </StackPanel>
                        </TabViewItem.Header>

                        <TabViewItem.Content>
                            <StackPanel
                                Padding="0"
                                Orientation="Vertical"
                                Spacing="10">

                                <!--Header-->
                                <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                                    <StackPanel
                                        Margin="10"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                        <FontIcon
                                            Glyph="&#xE9F9;"/>

                                        <TextBlock
                                            Text="FileSystemViewer scanning report"
                                            FontWeight="SemiBold"
                                            FontSize="15"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel
                                    Margin="10,0,0,0"
                                    Orientation="Horizontal"
                                    Spacing="10">

                                    <FontIcon
                                        Glyph="&#xEC92;"
                                        FontSize="15"/>

                                    <TextBlock>
                                        <Run Text="Scan date:"/>
                                        <Run Text="{Binding ScanDateTime}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel
                                    Margin="10,0,0,0"
                                    Orientation="Horizontal"
                                    Spacing="10">

                                    <FontIcon
                                        Glyph="&#xE916;"
                                        FontSize="15"/>

                                    <TextBlock>
                                        <Run Text="Total elapsed time:"/>
                                        <Run Text="{Binding ElapsedTime, Converter={StaticResource TimeSpanIntoStringConverter}}"/>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock
                                    Margin="10,10,0,0"
                                    FontWeight="SemiBold"
                                    FontSize="15"
                                    Text="Overall summary"/>

                                <!--Overall summary-->
                                <StackPanel
                                    Margin="20,0,0,0"
                                    Orientation="Vertical"
                                    Spacing="10">

                                    <StackPanel
                                        Spacing="5"
                                        Orientation="Horizontal">

                                        <FontIcon
                                            Glyph="&#xE958;"
                                            FontSize="14"/>

                                        <TextBlock>
                                            <Run Text="Root nodes scanned:"/>
                                            <Run Text="{Binding NodesScanned}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel
                                        Spacing="5"
                                        Orientation="Horizontal">

                                        <FontIcon
                                            Glyph="&#xE7F1;"
                                            FontSize="14"/>

                                        <TextBlock>
                                            <Run Text="Total size:"/>
                                            <Run Text="{Binding TotalSize, Converter={StaticResource BytesIntoSuitableFormatConverter}}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel
                                        Spacing="5"
                                        Orientation="Horizontal">

                                        <FontIcon
                                            Glyph="&#xE7C3;"
                                            FontSize="14"/>

                                        <TextBlock>
                                            <Run Text="Total files count:"/>
                                            <Run Text="{Binding TotalFilesCount}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel
                                        Spacing="5"
                                        Orientation="Horizontal">

                                        <FontIcon
                                            Glyph="&#xE8B7;"
                                            FontSize="14"/>

                                        <TextBlock>
                                            <Run Text="Total directories count:"/>
                                            <Run Text="{Binding TotalDirectoriesCount}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock
                                    Margin="10,10,0,0"
                                    FontWeight="SemiBold"
                                    FontSize="15"
                                    Text="Individual drives"/>

                                <ListView
                                    Margin="10,0,10,0"
                                    ItemsSource="{Binding RootNodes}"
                                    ItemTemplate="{StaticResource FileSystemNodeListViewTemplate}">
                                </ListView>
                            </StackPanel>
                        </TabViewItem.Content>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>
    </Border>
</Page>
