<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileSystemViewer.Views.Pages.ReportViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileSystemViewer.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:l="using:WinUI3Localizer"
    mc:Ignorable="d">

    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <TabView
            x:Name="ReportTabView"
            TabCloseRequested="ReportTabView_TabCloseRequested"
            AddTabButtonClick="ReportTabView_AddTabButtonClick"
            SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
            TabItemsSource="{x:Bind ViewModel.ScanReports, Mode=OneWay}"
            VerticalAlignment="Stretch">

            <TabView.TabItemTemplate>
                <DataTemplate>
                    <TabViewItem>
                        <TabViewItem.Header>
                            <StackPanel
                                Orientation="Horizontal">
                                <TextBlock
                                    Text="{Binding Name}"
                                    Width="200"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{Binding Name}"/>
                            </StackPanel>
                        </TabViewItem.Header>

                        <TabViewItem.Content>
                            <Grid>
                                <StackPanel
                                    Padding="0"
                                    Orientation="Vertical"
                                    Spacing="10">

                                    <!--Header-->
                                    <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
                                        <StackPanel
                                            Margin="10"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                            <FontIcon
                                                Glyph="&#xE9F9;"/>

                                            <TextBlock
                                                l:Uids.Uid="ReportHeader"
                                                FontWeight="SemiBold"
                                                FontSize="15"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel
                                        Margin="10,0,0,0"
                                        Orientation="Horizontal"
                                        Spacing="10">

                                        <FontIcon
                                            Glyph="&#xEC92;"
                                            FontSize="15"/>

                                        <TextBlock>
                                            <Run l:Uids.Uid="ReportScanDate"/>
                                            <Run Text="{Binding ScanDateTime}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel
                                        Margin="10,0,0,0"
                                        Orientation="Horizontal"
                                        Spacing="10">

                                        <FontIcon
                                            Glyph="&#xE916;"
                                            FontSize="15"/>

                                        <TextBlock>
                                            <Run l:Uids.Uid="ReportElapsedTime"/>
                                            <Run Text="{Binding ElapsedTime, Converter={StaticResource TimeSpanIntoStringConverter}}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock
                                        Margin="10,10,0,0"
                                        FontWeight="SemiBold"
                                        FontSize="15"
                                        l:Uids.Uid="ReportOverallHeader"/>

                                    <!--Overall summary-->
                                    <StackPanel
                                        Margin="20,0,0,0"
                                        Orientation="Vertical"
                                        Spacing="10">

                                        <StackPanel
                                            Spacing="5"
                                            Orientation="Horizontal">

                                            <FontIcon
                                                Glyph="&#xE958;"
                                                FontSize="14"/>

                                            <TextBlock>
                                                <Run l:Uids.Uid="ReportRootNodes"/>
                                                <Run Text="{Binding NodesScanned}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel
                                            Spacing="5"
                                            Orientation="Horizontal">

                                            <FontIcon
                                                Glyph="&#xE7F1;"
                                                FontSize="14"/>

                                            <TextBlock>
                                                <Run l:Uids.Uid="ReportTotalSize"/>
                                                <Run Text="{Binding TotalSize, Converter={StaticResource BytesIntoSuitableFormatConverter}}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel
                                            Spacing="5"
                                            Orientation="Horizontal">

                                            <FontIcon
                                                Glyph="&#xE7C3;"
                                                FontSize="14"/>

                                            <TextBlock>
                                                <Run l:Uids.Uid="ReportTotalFileCount"/>
                                                <Run Text="{Binding TotalFilesCount}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel
                                            Spacing="5"
                                            Orientation="Horizontal">

                                            <FontIcon
                                                Glyph="&#xE8B7;"
                                                FontSize="14"/>

                                            <TextBlock>
                                                <Run l:Uids.Uid="ReportTotalDirectoriesCount"/>
                                                <Run Text="{Binding TotalDirectoriesCount}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock
                                        Margin="10,10,0,0"
                                        FontWeight="SemiBold"
                                        FontSize="15"
                                        l:Uids.Uid="ReportIndividulDrivesHeader"/>

                                    <ListView
                                        Margin="10,0,10,0"
                                        ItemsSource="{Binding RootNodes}"
                                        ItemTemplate="{StaticResource FileSystemNodeListViewTemplate}">
                                    </ListView>
                                </StackPanel>
                            </Grid>
                        </TabViewItem.Content>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>

            <TabView.TabStripFooter>
                <Button
                    Height="30"
                    BorderThickness="0"
                    HorizontalAlignment="Right"
                    Margin="0,0,5,0"
                    Command="{x:Bind ViewModel.CloseAllReportsCommand}"
                    Style="{StaticResource AccentButtonStyle}">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="7">
                        
                        <FontIcon Glyph="&#xE894;" FontSize="15"
                                  Margin="0,3,0,0"/>
                        <TextBlock l:Uids.Uid="ReportCloseAll" FontSize="13"/>
                    </StackPanel>
                </Button>
            </TabView.TabStripFooter>
        </TabView>
    </Border>
</Page>
