<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModernControls.Controls"
    xmlns:converters="using:ModernControls.Converters">
    
    <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>

    <Style TargetType="local:Treemap">
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Treemap">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="TitleBar" Height="35"/>
                                <RowDefinition x:Name="Content"/>
                            </Grid.RowDefinitions>

                            <Border
                                x:Name="titleBorder"
                                Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                Grid.Row="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        x:Name="PART_BackButton"
                                        Margin="5,0,0,0"
                                        Grid.Column="0"
                                        Height="25"
                                        Width="35">

                                        <Viewbox>
                                            <FontIcon
                                                Glyph="&#xE72B;"/>
                                        </Viewbox>
                                    </Button>

                                    <Grid
                                        Grid.Column="1"
                                        x:Name="CurentSectionName">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition x:Name="SectionNameColumn"/>
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            Grid.Column="0"
                                            FontSize="14"
                                            Glyph="&#xE81B;"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="13"
                                            Width="{Binding ElementName=SectionNameColumn, Path=ActualWidth}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center"
                                            Text="{TemplateBinding CurrentLevelName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{TemplateBinding CurrentLevelName}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Canvas
                                x:Name="PART_Canvas"
                                Grid.Row="1"
                                Background="Transparent"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:TreemapItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TreemapItem">
                    <Border
                        Background="{Binding NodeData.BackgroundColor, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource ColorToBrushConverter}}"
                        CornerRadius="4"
                        Margin="1" 
                        Padding="4"
                        ToolTipService.ToolTip="{Binding NodeData.LabeledName, RelativeSource={RelativeSource Mode=TemplatedParent}}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                HorizontalAlignment="Left"
                                Padding="3"
                                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                                CornerRadius="2">
                                
                                <TextBlock
                                    Text="{Binding NodeData.LabeledName, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <Border
                                Grid.Row="1"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Right"
                                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                                Padding="2"
                                CornerRadius="2">
                                
                                <TextBlock
                                    Text="{Binding NodeData.Percent, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                    Foreground="White"
                                    Opacity="0.7"
                                    FontSize="12"/>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
