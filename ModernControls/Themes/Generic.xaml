<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModernControls.Controls"
    xmlns:converters="using:ModernControls.Converters"
    xmlns:tools="using:ModernControls.Tools">

    <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    <converters:BytesIntoSuitableFormatConverter x:Key="BytesIntoSuitableFormatConverter"/>

    <DataTemplate x:Key="RegularTreemapItemTemplate">
        <Grid>
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="3"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                CornerRadius="2">

                <TextBlock
                    Text="{Binding LabeledName}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    FontSize="13"
                    TextTrimming="CharacterEllipsis"/>
            </Border>

            <Border
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                Padding="2"
                CornerRadius="2">

                <TextBlock
                    Text="{Binding Size, Converter={StaticResource BytesIntoSuitableFormatConverter}}"
                    Foreground="White"
                    Opacity="0.7"
                    FontSize="12"/>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ContainerTreemapItemTemplate">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                HorizontalAlignment="Left"
                Padding="3"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                CornerRadius="2">

                <TextBlock
                    Text="{Binding LabeledName}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    FontSize="13"
                    TextTrimming="CharacterEllipsis"/>
            </Border>

            <Border
                Grid.Row="1"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                Padding="2"
                CornerRadius="2">

                <TextBlock
                    Text="{Binding Size, Converter={StaticResource BytesIntoSuitableFormatConverter}}"
                    Foreground="White"
                    Opacity="0.7"
                    FontSize="12"/>
            </Border>
        </Grid>
    </DataTemplate>

    <tools:TreemapItemTemplateSelector 
        x:Key="TreemapItemTemplateSelector" 
        ContainerTemplate="{StaticResource ContainerTreemapItemTemplate}" 
        RegularTemplate="{StaticResource RegularTreemapItemTemplate}"/>

    <Style TargetType="local:HierarchicalTreemap">
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HierarchicalTreemap">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="TitleBar" Height="35"/>
                                <RowDefinition x:Name="Content"/>
                            </Grid.RowDefinitions>

                            <Border
                                x:Name="titleBorder"
                                Background="{TemplateBinding Background}"
                                Grid.Row="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        x:Name="PART_BackButton"
                                        Margin="5,0,0,0"
                                        Grid.Column="0"
                                        Height="25"
                                        Width="35">

                                        <Viewbox>
                                            <FontIcon
                                                Glyph="&#xE72B;"/>
                                        </Viewbox>
                                    </Button>

                                    <Grid
                                        Grid.Column="1"
                                        x:Name="CurentSectionName">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition x:Name="SectionNameColumn"/>
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            Grid.Column="0"
                                            FontSize="14"
                                            FontFamily="Segoe Fluent Icons"
                                            Glyph="{TemplateBinding GlyphIcon}"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="13"
                                            Width="{Binding ElementName=SectionNameColumn, Path=ActualWidth}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center"
                                            Text="{TemplateBinding CurrentLevelName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{TemplateBinding CurrentLevelName}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Canvas
                                x:Name="PART_Canvas"
                                Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:TreemapItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TreemapItem">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal"/>

                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="2"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetName="PressedOverlay"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.25" Duration="0:0:0.05"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border
                            x:Name="border"
                            Background="{Binding NodeData.BackgroundColor, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource ColorToBrushConverter}}"
                            BorderBrush="White"
                            BorderThickness="0"
                            CornerRadius="3"
                            Margin="1" 
                            Padding="4">

                            <ToolTipService.ToolTip>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="{Binding NodeData.LabeledName, RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                                    <TextBlock Text="{Binding NodeData.Size, Converter={StaticResource BytesIntoSuitableFormatConverter}, RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                                </StackPanel>
                            </ToolTipService.ToolTip>
                            
                            <Grid>
                                <ContentControl
                                    Content="{TemplateBinding NodeData}"
                                    ContentTemplateSelector="{StaticResource TreemapItemTemplateSelector}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"/>

                                <Border x:Name="PressedOverlay" 
                                    Background="Black" 
                                    Opacity="0" 
                                    CornerRadius="4" 
                                    IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="PART_OpenMenuItem" Text="Open">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEC50;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
